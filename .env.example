# Local Media Processor - Environment Configuration
# Copy this file to .env and modify as needed

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Service URLs
API_GATEWAY_URL=http://localhost:8000
TRANSCRIPTION_SERVICE_URL=http://localhost:8001
TRANSLATION_SERVICE_URL=http://localhost:8002
OCR_SERVICE_URL=http://localhost:8003
TTS_SERVICE_URL=http://localhost:8004
SUBTITLE_SERVICE_URL=http://localhost:8005

# File Paths
MODELS_DIR=./models
TEMP_DIR=/tmp/media-processor

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Gradio UI (optional authentication)
# GRADIO_AUTH=username:password
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# API Gateway
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
API_GATEWORKERS=4
# API_GATEWAY_SECRET_KEY=change-me-in-production

# Processing Settings
TRANSCRIPTION_MODEL=base
TRANSCRIPTION_BATCH_SIZE=16
TRANSLATION_MODEL=nllb-200-distilled-600M
TRANSLATION_CHUNK_SIZE=3000
TTS_VOICE_MAP_RU=ru-RU-SvetlanaNeural
TTS_VOICE_MAP_EN=en-US-JennyNeural

# GPU Settings
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_FRACTION=0.8
